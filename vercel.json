{
  "version": 2,
  "outputDirectory": "public",
  "framework": null,
  "buildCommand": "npm run build",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 1792,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/build/$1"
    },
    {
      "src": "/(favicon.ico|favicon.svg|robots.txt)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "StockPro",
    "APP_ENV": "production",
    "APP_KEY": "base64:P9L3SY2/90CnF3q2roWDYSJ62MRbwa4LAe8AUd/MHdc=",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite"
  }
}
